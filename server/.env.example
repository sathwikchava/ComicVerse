# Port Configuration
PORT=5000

# Database Connection (MongoDB)
# Local: mongodb://localhost:27017/comicverse
# Production: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/comicverse?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/comicverse

# Razorpay Developer Credentials
# Get these from Razorpay Dashboard -> Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere

# Razorpay Checkout Settings
# default is INR. For global cards support, ensure currency matches and international cards are enabled.
RAZORPAY_CURRENCY=INR

# Clerk API Keys
# Get these from Clerk Dashboard -> API Keys
CLERK_PUBLISHABLE_KEY=pk_test_YourPublishableKeyHere
CLERK_SECRET_KEY=sk_test_YourSecretKeyHere
